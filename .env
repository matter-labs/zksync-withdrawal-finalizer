#The address of Ethereum WebSocket RPC endpoint
ETH_CLIENT_WS_URL=ws://localhost:8545
#The address of Ethereum HTTP RPC endpoint
ETH_CLIENT_HTTP_URL=http://localhost:8545
#Address of the zkSync Era WebSocket RPC endpoint
#API_WEB3_JSON_RPC_WS_URL=ws://mainnet.era.zksync.io
API_WEB3_JSON_RPC_WS_URL=ws://sepolia.era.zksync.dev #ws://external-node-sepolia.era.zksync.dev/
#Address of the zkSync Era HTTP RPC endpoint
#API_WEB3_JSON_RPC_HTTP_URL=https://mainnet.era.zksync.io
API_WEB3_JSON_RPC_HTTP_URL=https://sepolia.era.zksync.dev #https://external-node-sepolia.era.zksync.dev/
#Address of the zkSync Gateway WebSocket RPC endpoint
SL_CLIENT_WS_URL=ws://rpc.era-gateway-testnet.zksync.dev
#Address of the zkSync Gateway HTTP RPC endpoint
SL_CLIENT_HTTP_URL=https://rpc.era-gateway-testnet.zksync.dev 

#The url of PostgreSQL database the service stores its state into
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finalizer

#Address of the L1 ERC20 bridge contract (sepolia)
CONTRACTS_L1_ERC20_BRIDGE_PROXY_ADDR="0x2Ae09702F77a4940621572fBcDAe2382D44a2cbA"	
#Address of the L1 ERC20 bridge contract (mainnet)
#CONTRACTS_L1_ERC20_BRIDGE_PROXY_ADDR="0x57891966931Eb4Bb6FB81430E6cE0A03AAbDe063"
#Address of the L2 ERC20 bridge contract (sepolia)
CONTRACTS_L2_ERC20_BRIDGE_ADDR="0x681A1AFdC2e06776816386500D2D461a6C96cB45"	
#Address of the L2 ERC20 bridge contract (mainnet)
#CONTRACTS_L2_ERC20_BRIDGE_ADDR="0x11f943b2c77b743AB90f4A0Ae7d5A4e7FCA3E102"
#Address of the L1 diamond proxy contract (sepolia)
CONTRACTS_DIAMOND_PROXY_ADDR="0x9a6de0f62aa270a8bcb1e2610078650d539b1ef9"
#Address of the L1 diamond proxy contract (mainnet)
#CONTRACTS_DIAMOND_PROXY_ADDR="0x32400084c286cf3e17e7b677ea9583e60a000324"
#Address of the Withdrawal Finalizer contract 
CONTRACTS_WITHDRAWAL_FINALIZER_CONTRACT="0x32b6F45f18F9f46e9177f01A61CB1b0757b156f3"

#START_FROM_L2_BLOCK=5337177

#The gas limit of a single withdrawal finalization within the batch of withdrawals finalized in a call to finalizeWithdrawals in WithdrawalFinalizerContract
GAS_LIMIT=100000000	
#The gas limit of the finalization of the whole batch in a call to finalizeWithdrawals in Withdrawal Finalizer Contract
BATCH_FINALIZATION_GAS_LIMIT=10000000000	
#The private key of the account that is going to be submit finalization transactions
WITHDRAWAL_FINALIZER_ACCOUNT_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"	
#Number of seconds to wait for a potentially stuck finalization transaction before readjusting its fees
TX_RETRY_TIMEOUT_SECS=5	

#FINALIZE_ETH_TOKEN=	#(Optional) Configure, whether the Ethereum withdrawal events should be monitored. Useful to turn off for custom bridges that are only interested in a particular ERC20 token and have nothing to do with main Ethereum withdrawals
#CUSTOM_TOKEN_DEPLOYER_ADDRESSES=	#(Optional) Normally ERC20 tokens are deployed by the bridge contract. However, in custom cases it may be necessary to override that behavior with a custom set of addresses that have deployed tokens
#CUSTOM_TOKEN_ADDRESSES=	#(Optional) Adds a predefined list of tokens to finalize. May be useful in case of custom bridge setups when the regular technique of finding token deployments does not work.
#ENABLE_WITHDRAWAL_METERING=	#(Optional, default: "true") By default Finalizer collects metrics about withdrawn token volumens. Users may optionally switch off this metering.
#ETH_FINALIZATION_THRESHOLD=	#(Optional, default: "0") Finalizer will only finalize ETH withdrawals that are greater or equal to this value
#ONLY_FINALIZE_THESE_TOKENS=	#(Optional, default: None) If specified, creates a whitelist of erc20 tokens that will be finalized.
